NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shamba_direct
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_ORIGIN=http://localhost:3000
# Optional comma-separated HTTPS origins for native apps (Android Capacitor uses https://localhost).
ADDITIONAL_CORS_ORIGINS=
DEFAULT_DELIVERY_FEE_KES=500

# Cards (Stripe Checkout). Leave blank to keep card payments unavailable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# M-Pesa Daraja STK Push. Use sandbox credentials until production approval.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Manual methods are available only when their required configuration is present.
BANK_TRANSFER_INSTRUCTIONS=
ENABLE_CASH_ON_DELIVERY=false

# Resend email verification and password recovery. Use a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=Shamba Direct <accounts@example.com>
PUBLIC_APP_URL=http://localhost:3000

# Cloudflare R2 object storage. Never expose the access key or secret in frontend code.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Subscription card billing uses Stripe recurring Checkout. M-Pesa renewals are manual.
